# Copy to .env for local development. Never commit .env.
# On Streamlit Community Cloud, set the same keys in st.secrets.

# Google AI Studio API key (free tier).
LLM_API_KEY=

# Model ID exactly as shown in AI Studio. Flash-Lite is the default because the
# free tier gives it far more requests per day than the larger Flash models.
# Left blank on purpose: the app refuses to call the LLM until this is set.
LLM_MODEL=

# Answer generation. Temperature stays at 0: reading a figure out of a passage has one
# right answer, and a warmer model sometimes refuses a question it could answer.
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=45
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=1.0
MAX_CONTEXT_CHARS=14000

# Retrieval and chunking knobs. Defaults live in rag/config.py.
CHUNK_MIN_TOKENS=400
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_RATIO=0.12
TOP_K=6
RETRIEVAL_METHOD=hybrid

# Answers whose best match scores below this are refused without calling the LLM.
# Tuned from real data later; 0 disables the floor.
MIN_RELEVANCE_SCORE=0.0

# Quota protection for the public demo. DAILY_REQUEST_CAP=0 disables the cap.
SESSION_COOLDOWN_SECONDS=3
DAILY_REQUEST_CAP=200
CACHE_SIZE=128
