# Copy to .env for local development. Never commit .env.
# On Streamlit Community Cloud, set the same keys in st.secrets.

# Google AI Studio API key (free tier).
LLM_API_KEY=

# Model ID exactly as shown in AI Studio, for example a Gemini Flash model.
# Left blank on purpose: the app refuses to call the LLM until this is set.
LLM_MODEL=

# Retrieval and chunking knobs. Defaults live in rag/config.py.
CHUNK_MIN_TOKENS=400
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_RATIO=0.12
TOP_K=6
RETRIEVAL_METHOD=hybrid

# Quota protection for the public demo.
SESSION_COOLDOWN_SECONDS=3
DAILY_REQUEST_CAP=200
